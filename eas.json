{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3060",
        "EXPO_PUBLIC_PAYMENT_PROVIDER": "paystack"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.evotv.co",
        "EXPO_PUBLIC_PAYMENT_PROVIDER": "paystack"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.evotv.co",
        "EXPO_PUBLIC_PAYMENT_PROVIDER": "paystack"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "//": "Fill these in once the Apple Developer account exists. ascAppId is the numeric App Store Connect app id, not the bundle identifier.",
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      },
      "android": {
        "//": "Play Console service account JSON, when there is a Play listing.",
        "serviceAccountKeyPath": "",
        "track": "internal"
      }
    }
  }
}
